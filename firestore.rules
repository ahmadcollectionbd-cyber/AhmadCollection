rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Public read content
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /banners/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /coupons/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Site-wide configuration. Public-readable so the storefront can render
    // delivery charges / payment numbers / pixel ids. Only admins write.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin-authored broadcast announcements shown in every user's bell
    // dropdown. Public-readable so customers can render them; only admins
    // can publish, edit, or retract.
    match /announcements/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // User profiles
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      // Users may patch their own profile, but cannot escalate role to admin
      allow update: if isAdmin() || (
        isOwner(uid) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // Orders — guests can create, owners and admin can read.
    // Owners may also patch only their order's status to 'cancelled' / 'returned'
    // (so customers can cancel pending orders or request return after delivery).
    //
    // `get` is intentionally public so the Track Order page works for guests
    // without exposing arbitrary docs to enumeration: new orders are stored
    // at /orders/{shortId} where shortId is an 8-char unguessable token
    // (~8e11 combinations). `list` queries are still restricted to the
    // owner / admin so the collection cannot be paginated.
    match /orders/{id} {
      allow create: if true;
      allow get: if true;
      allow list: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.status in ['cancelled', 'returned', 'delivered']
      );
      allow delete: if isAdmin();
    }

    // Order notifications — clients enqueue, admin processes
    match /notifications/{id} {
      allow create: if true;
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Reviews — public read; anyone can submit (guests included) so customers
    // can leave feedback without signing in. Signed-in users tag their review
    // with their own uid; guests tag it with the literal string "guest".
    // Admins can edit/hide; signed-in authors can edit/delete their own.
    match /reviews/{id} {
      allow read: if true;
      allow create: if
        request.resource.data.productId is string &&
        request.resource.data.userName is string &&
        request.resource.data.rating is number &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() > 0 &&
        request.resource.data.comment.size() <= 1000 &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        (
          (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
          (request.resource.data.userId == 'guest')
        );
      allow update, delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }
  }
}
